# 複製成 .env 後填入（.env 不要 commit）

# GitHub token：匿名每小時只有 60 次 API，有 token 可到 5000 次（不需任何權限的 fine-grained token 即可）
GITHUB_TOKEN=

# 分析用的 LLM：openai（預設）或 anthropic；沒填 key 就用內建規則式分析
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=            # 選填：Azure OpenAI / 相容的 proxy

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- 每日 email 日報（不填就只存到 data/digests/）----
# Gmail：SMTP_HOST=smtp.gmail.com、SMTP_PORT=587，SMTP_PASSWORD 要用「應用程式密碼」（需開兩步驟驗證）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# 信裡的「打開網頁」連結
PUBLIC_URL=http://127.0.0.1:5000

TZ=Asia/Taipei
PORT=5000
